{
  "name": "woxa/erp",
  "description": "erp based on arbor",
  "type": "project",
  "authors": [
    {
      "name": "Harshit Mishra",
      "email": "harshittmishra@gmail.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "C:/xampp/htdocs/uc/arbor/arbor",
      "options": {
        "symlink": true,
        "versions": {
          "unifiedcodes/arbor": "dev-main"
        }
      }
    }
  ],
  "require": {
    "unifiedcodes/arbor": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "Sys\\": "sys/",
      "App\\": "app/"
    }
  }
}
